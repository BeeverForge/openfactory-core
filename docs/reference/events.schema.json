    "JobsData": {
      "additionalProperties": true,
      "description": "The durable jobs' state (`/api/temporal/stream`). `jobs` is ALWAYS sent, and is `null` when\nthe engine could not be read — never `[]`, which is an engine that answered with nothing.\nA connected frame says where the engine's UI is (`ui_base`), and the sentence that stands in\nfor the link when nobody said (`ui_hint`, `\"\"` when `ui_base` is known).",
      "properties": {
        "connected": {
          "title": "Connected",
          "type": "boolean"
        },
        "jobs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EngineJob"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Jobs"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "ui_base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ui Base"
        },
        "ui_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ui Hint"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "intake": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intake"
        },
        "build": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build"
        }
      },
      "required": [
        "connected",
        "jobs"
      ],
      "title": "JobsData",
      "type": "object"
    },
    "JobsEvent": {
      "properties": {
        "kind": {
          "const": "jobs",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
