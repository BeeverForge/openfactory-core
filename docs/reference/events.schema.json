{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenFactory event",
  "description": "One typed event, for every stream the API pushes.",
  "discriminator": {
    "mapping": {
      "ack": "#/$defs/AckEvent",
      "bye": "#/$defs/ByeEvent",
      "earlier": "#/$defs/EarlierEvent",
      "ended": "#/$defs/EndedEvent",
      "hello": "#/$defs/HelloEvent",
      "history": "#/$defs/HistoryEvent",
      "jobs": "#/$defs/JobsEvent",
      "log": "#/$defs/LogEvent",
      "presence": "#/$defs/PresenceEvent",
      "refused": "#/$defs/RefusedEvent",
      "reply": "#/$defs/ReplyEvent",
      "resync": "#/$defs/ResyncEvent",
      "said": "#/$defs/SaidEvent",
      "staged": "#/$defs/StagedEvent",
      "subscribed": "#/$defs/SubscribedEvent",
      "update": "#/$defs/UpdateEvent"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/HelloEvent"
    },
    {
      "$ref": "#/$defs/UpdateEvent"
    },
    {
      "$ref": "#/$defs/ByeEvent"
    },
    {
      "$ref": "#/$defs/SubscribedEvent"
    },
    {
      "$ref": "#/$defs/HistoryEvent"
    },
    {
      "$ref": "#/$defs/EarlierEvent"
    },
    {
      "$ref": "#/$defs/SaidEvent"
    },
    {
      "$ref": "#/$defs/ReplyEvent"
    },
    {
      "$ref": "#/$defs/StagedEvent"
    },
    {
      "$ref": "#/$defs/PresenceEvent"
    },
    {
      "$ref": "#/$defs/AckEvent"
    },
    {
      "$ref": "#/$defs/RefusedEvent"
    },
    {
      "$ref": "#/$defs/ResyncEvent"
    },
    {
      "$ref": "#/$defs/JobsEvent"
    },
    {
      "$ref": "#/$defs/LogEvent"
    },
    {
      "$ref": "#/$defs/EndedEvent"
    }
  ],
  "$defs": {
    "AckData": {
      "additionalProperties": true,
      "description": "What became of a message the page sent, by the id the page gave it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "ahead": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ahead"
        }
      },
      "required": [
        "id",
        "ok",
        "text"
      ],
      "title": "AckData",
      "type": "object"
    },
    "AckEvent": {
      "properties": {
        "kind": {
          "const": "ack",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "product": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product"
        },
        "data": {
          "$ref": "#/$defs/AckData"
        }
      },
      "required": [
        "kind",
        "id",
        "at",
        "data"
      ],
      "title": "AckEvent",
      "type": "object"
    },
    "ByeData": {
      "additionalProperties": true,
      "description": "A socket is closing. `ended` is there when the credential stopped opening it; without it,\n`reason` is what broke.",
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "ended": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndedData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "reason"
      ],
      "title": "ByeData",
      "type": "object"
    },
    "ByeEvent": {
      "properties": {
        "kind": {
          "const": "bye",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "product": {
          "default": null,
          "title": "Product",
          "type": "null"
        },
        "data": {
          "$ref": "#/$defs/ByeData"
        }
      },
      "required": [
        "kind",
        "id",
        "at",
        "data"
      ],
      "title": "ByeEvent",
      "type": "object"
    },
    "ChannelMessage": {
