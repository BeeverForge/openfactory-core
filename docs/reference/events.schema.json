        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "product": {
          "default": null,
          "title": "Product",
          "type": "null"
        },
        "data": {
          "$ref": "#/$defs/JobsData"
        }
      },
      "required": [
        "kind",
        "id",
        "at",
        "data"
      ],
      "title": "JobsEvent",
      "type": "object"
    },
    "LogData": {
      "additionalProperties": true,
      "description": "One line of a run's log, as the journal wrote it (`observability.events.JobEvent`).",
      "properties": {
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "ticket_id": {
          "title": "Ticket Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "state",
            "agent_action",
            "validation",
            "review",
            "pr",
            "note",
            "warning",
            "error"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "ts",
        "job_id",
        "ticket_id",
        "kind",
        "message"
      ],
      "title": "LogData",
      "type": "object"
    },
    "LogEvent": {
      "properties": {
        "kind": {
          "const": "log",
