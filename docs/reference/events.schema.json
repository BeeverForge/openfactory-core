          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "ts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ts"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        }
      },
      "title": "ChannelMessage",
      "type": "object"
    },
    "EarlierData": {
      "additionalProperties": true,
      "description": "The page of turns before the one shown, as the page asked.",
      "properties": {
        "turns": {
          "items": {
            "$ref": "#/$defs/Turn"
          },
          "title": "Turns",
          "type": "array"
        },
        "earlier": {
          "title": "Earlier",
          "type": "string"
        }
      },
      "required": [
        "turns",
        "earlier"
      ],
      "title": "EarlierData",
      "type": "object"
    },
    "EarlierEvent": {
      "properties": {
        "kind": {
          "const": "earlier",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "product": {
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EarlierData"
        }
      },
      "required": [
        "kind",
        "id",
        "at",
        "product",
        "data"
      ],
      "title": "EarlierEvent",
      "type": "object"
    },
    "EndedData": {
      "additionalProperties": true,
      "description": "Why a stream stopped: the gate's answer to the credential it was opened with — `why` and\n`status`, beside the refusal's own body. Every refusal says `detail`; a 401 from a provider\nwith a login page also names it (`login`), so the page can send the browser there.",
      "properties": {
        "why": {
          "enum": [
            "signed_out",
            "not_allowed",
            "unavailable"
          ],
          "title": "Why",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "integer"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "login": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login"
        }
      },
      "required": [
        "why",
        "status",
        "detail"
      ],
      "title": "EndedData",
      "type": "object"
    },
    "EndedEvent": {
      "properties": {
        "kind": {
          "const": "ended",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "product": {
          "default": null,
          "title": "Product",
          "type": "null"
        },
        "data": {
          "$ref": "#/$defs/EndedData"
        }
      },
      "required": [
        "kind",
        "id",
        "at",
        "data"
      ],
      "title": "EndedEvent",
      "type": "object"
    },
    "EngineJob": {
      "additionalProperties": true,
      "description": "One job as the durable engine lists it (`runtime.temporal.view.list_jobs`).",
      "properties": {
        "workflow_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "issue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "action": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "attention": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attention"
        },
        "wedged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wedged"
        }
      },
      "title": "EngineJob",
      "type": "object"
    },
    "Envelope": {
      "description": "One event, from any stream. `id` names it within its stream; `at` is when it was sent;\n`project` is the project it is about, when there is one; `product` is the product's key, for\nthe kinds in `PRODUCT_KINDS`, and for an answer (`ack`, `refused`) about one.",
      "properties": {
        "kind": {
          "enum": [
            "hello",
            "update",
            "bye",
            "subscribed",
            "history",
            "earlier",
            "said",
            "reply",
            "staged",
            "presence",
            "ack",
            "refused",
            "resync",
            "jobs",
            "log",
            "ended"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product"
        },
        "data": {
          "$ref": "#/$defs/EventData"
        }
      },
      "required": [
        "kind",
        "id",
        "at",
        "data"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "EventData": {
      "additionalProperties": true,
      "description": "What one kind of event carries: its named fields, and whatever else it carries.",
      "properties": {},
      "title": "EventData",
      "type": "object"
    },
    "HelloData": {
      "additionalProperties": true,
      "description": "A socket opened. The floor's says how often it re-reads (`tick`, seconds); the chat's says\nnothing more.",
      "properties": {
        "tick": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tick"
        }
      },
      "title": "HelloData",
      "type": "object"
    },
    "HelloEvent": {
      "properties": {
        "kind": {
          "const": "hello",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "product": {
          "default": null,
          "title": "Product",
          "type": "null"
        },
        "data": {
          "$ref": "#/$defs/HelloData"
        }
      },
      "required": [
        "kind",
        "id",
        "at",
        "data"
      ],
      "title": "HelloEvent",
      "type": "object"
    },
    "HistoryData": {
      "additionalProperties": true,
      "description": "The conversation's recent turns, handed on (re)subscribing. `staged` is what waits for the\nperson's answer, `null` when nothing does; `earlier` is the cursor of the page before them,\n`\"\"` when these are all of it.",
      "properties": {
        "turns": {
          "items": {
            "$ref": "#/$defs/Turn"
          },
          "title": "Turns",
          "type": "array"
        },
        "staged": {
          "anyOf": [
            {
              "$ref": "#/$defs/Staged"
            },
            {
              "type": "null"
            }
          ]
        },
        "earlier": {
          "title": "Earlier",
          "type": "string"
        }
      },
      "required": [
        "turns",
        "staged",
        "earlier"
      ],
      "title": "HistoryData",
      "type": "object"
    },
    "HistoryEvent": {
      "properties": {
        "kind": {
          "const": "history",
          "title": "Kind",
          "type": "string"
        },
        "id": {
